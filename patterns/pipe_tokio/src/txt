#[cfg(test)]
mod tests {
    use std::{
        collections::VecDeque,
        sync::{Arc, Mutex as StdMutex},
        time::Duration,
    };

    use tokio::{sync::Notify, time::timeout};

    use super::*;

    struct TestSource {
        batches: VecDeque<(Vec<u32>, Cookie)>,
    }

    impl Source for TestSource {
        type Item = u32;
        type Error = &'static str;

        async fn next(&mut self) -> Result<(Vec<Self::Item>, Cookie), Self::Error> {
            self.batches.pop_front().ok_or("source exhausted")
        }
    }

    struct TestCommitter {
        commits: Arc<StdMutex<Vec<Cookie>>>,
    }

    impl Committer for TestCommitter {
        type Error = &'static str;

        async fn commit(&mut self, cookie: Cookie) -> Result<(), Self::Error> {
            self.commits
                .lock()
                .map_err(|_| "commits mutex poisoned")?
                .push(cookie);
            Ok(())
        }
    }

    struct TestConsumer {
        release_first: Arc<Notify>,
        fail_second: bool,
    }

    impl Consumer for TestConsumer {
        type Item = u32;
        type Error = &'static str;

        async fn process(&mut self, items: &[Self::Item]) -> Result<(), Self::Error> {
            match items[0] {
                1 => self.release_first.notified().await,
                2 if self.fail_second => return Err("second batch failed"),
                2 => self.release_first.notify_one(),
                _ => {}
            }

            Ok(())
        }
    }

    fn source() -> TestSource {
        TestSource {
            batches: VecDeque::from([(vec![1; 6_000], 1), (vec![2; 6_000], 2), (Vec::new(), 3)]),
        }
    }

    fn consumers(release_first: &Arc<Notify>, fail_second: bool) -> Vec<TestConsumer> {
        (0..2)
            .map(|_| TestConsumer {
                release_first: Arc::clone(release_first),
                fail_second,
            })
            .collect()
    }

    #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
    async fn commits_in_source_order_when_workers_finish_out_of_order() {
        let commits = Arc::new(StdMutex::new(Vec::new()));
        let release_first = Arc::new(Notify::new());

        let result = pipe_parallel(
            source(),
            TestCommitter {
                commits: Arc::clone(&commits),
            },
            consumers(&release_first, false),
            PipeConfig { queue_capacity: 2 },
        )
        .await;

        assert_eq!(result, Ok(()));
        assert_eq!(*commits.lock().expect("commits mutex poisoned"), [1, 2, 3]);
    }

    #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
    async fn returns_later_worker_error_without_waiting_for_earlier_batch() {
        let commits = Arc::new(StdMutex::new(Vec::new()));
        let release_first = Arc::new(Notify::new());

        let result = timeout(
            Duration::from_secs(1),
            pipe_parallel(
                source(),
                TestCommitter {
                    commits: Arc::clone(&commits),
                },
                consumers(&release_first, true),
                PipeConfig { queue_capacity: 2 },
            ),
        )
        .await
        .expect("pipe did not return the worker error immediately");

        assert_eq!(
            result,
            Err(PipeError::Consumer {
                sequence: 1,
                error: "second batch failed",
            })
        );
        assert!(commits.lock().expect("commits mutex poisoned").is_empty());
    }
}
